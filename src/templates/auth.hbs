<main>
    <h1 class="visually-hidden">Authorization</h1>
    <section class="login">
        <div class="login__container container">
            <form class="login__form form" action="#" method="post">
                <h2 class="form__title">Вход</h2>
                <fieldset class="form__field">
                    <legend class="visually-hidden">#</legend>
                    <ul class="form__list">
                        <li class="form__item">
                            <label class="form__label">
                                <span class="form__subtitle">Логин</span>
                                <input class="form__input" type="text" name="form" placeholder="ivanivanov">
                            </label>
                        </li>
                        <li class="form__item">
                            <label class="form__label">
                                <span class="form__subtitle">Пароль</span>
                                <input class="form__input" type="password" name="password" placeholder="Пароль">
                            </label>
                        </li>
                    </ul>
                </fieldset>
                <button class="form__button button button--primary" type="submit">Авторизоваться</button>
                <a class="form__link link" href="/auth">Нет аккаунта?</a>
            </form>
        </div>
    </section>
</main>