<main>
  <h1 class="visually-hidden">Profile</h1>

  <section class="profile">
    <div class="profile__container container">
      <form class="profile__avatar avatar" action="#" method="post">
        <img class="avatar__image" src="/images/icons/empty-photo.svg" width="40" height="40" alt="Фото профиля.">
        <label class="avatar__label">
          <span class="avatar__text">Поменять<br> аватар</span>
          <input class="avatar__input" type="file" name="avatar">
        </label>
      </form>
      <p class="profile__name">Иван</p>

      <form class="profile__form" action="#" method="post">
        <fieldset class="profile__field">
          <legend class="visually-hidden"></legend>
          <ul class="profile__list">
            <li class="profile__item">
              <label class="profile__label">
                <span class="profile__subtitle">Почта</span>
                <input maxlength="50" class="profile__input" type="text" name="email" placeholder="pochta@yandex.ru">
              </label>
            </li>
            <li class="profile__item">
              <label class="profile__label">
                <span class="profile__subtitle">Логин</span>
                <input maxlength="50" class="profile__input" type="text" name="login" placeholder="ivanivanov">
              </label>
            </li>
            <li class="profile__item">
              <label class="profile__label">
                <span class="profile__subtitle">Имя</span>
                <input maxlength="50" class="profile__input" type="text" name="first_name" placeholder="Иван">
              </label>
            </li>
            <li class="profile__item">
              <label class="profile__label">
                <span class="profile__subtitle">Фамилия</span>
                <input maxlength="50" class="profile__input" type="text" name="second_name" placeholder="Иванов">
              </label>
            </li>
            <li class="profile__item">
              <label class="profile__label">
                <span class="profile__subtitle">Имя в чате</span>
                <input maxlength="50" class="profile__input" type="text" name="display_name" placeholder="Иван">
              </label>
            </li>
            <li class="profile__item">
              <label class="profile__label">
                <span class="profile__subtitle">Телефон</span>
                <input maxlength="50" class="profile__input" type="tel" name="phone" placeholder="+7 (909) 967 30 30">
              </label>
            </li>
          </ul>

          <ul class="profile__buttons">
            <li class="profile__buttons-item">
              <button class="profile__button button" type="button">Изменить данные</button>
            </li>
            <li class="profile__buttons-item">
              {{!-- <button class="profile__button button" type="button">Изменить пароль</button> --}}
              <a class="profile__link" href="/password-change">Изменить пароль</a>
            </li>
            <li class="profile__buttons-item">
              <button class="profile__button profile__button--color button" type="button">Выйти</button>
            </li>
          </ul>
        </fieldset>
      </form>
    </div>
  </section>
</main>
