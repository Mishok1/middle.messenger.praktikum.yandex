<main>
    <h1 class="visually-hidden">Password change</h1>
    <section class="password-change">
        <div class="password-change__container container">

            <form class="password-change__avatar avatar" action="#" method="post">
                <img class="avatar__image" src="/images/icons/empty-photo.svg" width="40" height="40"
                    alt="Фото профиля.">
                <label class="avatar__label">
                    <span class="avatar__text">Поменять<br> аватар</span>
                    <input class="avatar__input" type="file" name="avatar">
                </label>
            </form>

            <form class="profile__form" action="#" method="post">
                <fieldset class="profile__field">
                    <legend class="visually-hidden"></legend>
                    <ul class="profile__list">
                        <li class="profile__item">
                            <label class="profile__label">
                                <span class="profile__subtitle">Старый пароль</span>
                                <input maxlength="50" class="profile__input" type="password" name="oldPassword"
                                    placeholder="•••••••••">
                            </label>
                        </li>
                        <li class="profile__item">
                            <label class="profile__label">
                                <span class="profile__subtitle">Новый пароль</span>
                                <input maxlength="50" class="profile__input" type="password" name="newPassword"
                                    placeholder="•••••••••••">
                            </label>
                        </li>
                        <li class="profile__item">
                            <label class="profile__label">
                                <span class="profile__subtitle">Повторите новый пароль</span>
                                <input maxlength="50" class="profile__input" type="password" name="newPasswordRepeat"
                                    placeholder="•••••••••••">
                            </label>
                        </li>
                    </ul>
                </fieldset>

                <button class="password-change__button button button--primary" type="submit">Сохранить</button>
            </form>
        </div>
    </section>
</main>
